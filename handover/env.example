# 5WA environment-variable name reference ONLY.
# Never commit real values. Configure production values in the WebDev/hosting secret store.

# Runtime
NODE_ENV=development
PORT=3000

# Public browser/build variables. Every VITE_* value is exposed in the client bundle.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_MAPBOX_TOKEN=

# Optional public metadata / analytics. Analytics is currently disabled in client/index.html.
VITE_APP_TITLE=
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Server-only configuration. Never use a VITE_ prefix for these values.
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
GROQ_API_KEY=

# Test control; this is not a secret. Keep disabled in ordinary test runs.
RUN_GROQ_INTEGRATION=0

# Supabase note:
# The current browser client URL and public anon credential are hardcoded in
# client/src/lib/supabase.ts. A future refactor may introduce public
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY variables, but the current code
# does not read them. Never expose a Supabase service_role/secret key to Vite.
